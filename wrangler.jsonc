{
  "name": "kpl-market-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kpl-market-data",
      "database_id": "3d718669-3018-409f-9132-24e00be50c6a"
    }
  ],
  "triggers": {
    "crons": [
      "30 7,8,10 * * MON-FRI"
    ]
  },
  "observability": {
    "enabled": true
  }
}
